    given-names: "<AUTHOR GIVEN NAME>"
    # orcid: "https://orcid.org/<AUTHOR ORCID>"  # uncomment and fill before release
license: AGPL-3.0-only
repository-code: "https://github.com/dorrabbkhan/NeoPhylo"
url: "https://<LIVE URL>"
# date-released: <DATE RELEASED>  # YYYY-MM-DD; uncomment and set on first release
keywords:
  - phylogenetics
  - neighbor-joining
  - UPGMA
  - distance methods
  - science education
  - interactive teaching
