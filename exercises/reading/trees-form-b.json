{
  "schema_version": 1,
  "kind": "reading",
  "id": "trees-form-b",
  "title": "Tree reading — form B",
  "summary": "A short before/after check of tree-reading skills — relatedness, clades and trait marks on animals and plants. These are NeoPhylo's own questions, not a validated instrument.",
  "meta": {
    "objectives": [
      "Compare trees and read relatedness from shared ancestry",
      "Tell clades from other groups and read trait marks including losses"
    ],
    "minutes": 15,
    "level": "intro",
    "prepares_for": []
  },
  "mode": "test",
  "taxa_pool": {
    "birds": ["lizard", "ostrich", "chicken", "duck", "penguin", "albatross"],
    "marsupials": ["opossum", "quoll", "kangaroo", "koala", "wombat"],
    "grasses": ["oak", "rice", "wheat", "corn"]
  },
  "trees": {
    "birds": {
      "newick": "(lizard,(ostrich,((chicken,duck),(penguin,albatross))));",
      "marks": [
        {
          "on": ["albatross", "chicken", "duck", "ostrich", "penguin"],
          "trait": "feathers",
          "change": "gain"
        },
        {
          "on": ["albatross", "chicken", "duck", "ostrich", "penguin"],
          "trait": "flight",
          "change": "gain"
        },
        { "on": ["ostrich"], "trait": "flight", "change": "loss" },
        { "on": ["penguin"], "trait": "flight", "change": "loss" }
      ],
      "traits": [
        {
          "name": "feathers",
          "ancestral": "featherless",
          "derived": "feathered"
        },
        { "name": "flight", "ancestral": "cannot fly", "derived": "can fly" }
      ]
    },
    "birds-rot": {
      "newick": "(lizard,(((penguin,albatross),(duck,chicken)),ostrich));"
    },
    "birds-diff": {
      "newick": "(lizard,(ostrich,((chicken,penguin),(duck,albatross))));"
    },
    "birds-lettered": {
      "newick": "(lizard,(ostrich,((chicken,duck),(penguin,albatross))));",
      "node_letters": [
        { "on": "root", "letter": "R" },
        {
          "on": ["albatross", "chicken", "duck", "ostrich", "penguin"],
          "letter": "B"
        },
        {
          "on": ["albatross", "chicken", "duck", "penguin"],
          "letter": "N"
        },
        { "on": ["chicken", "duck"], "letter": "G" },
        { "on": ["albatross", "penguin"], "letter": "A" }
      ]
    },
    "marsupials": {
      "newick": "(opossum,(quoll,(kangaroo,(koala,wombat))));"
    },
    "grasses": {
      "newick": "(oak,(rice,wheat,corn));"
    }
  },
  "items": [
    {
      "id": "q-evolved",
      "text": "On this tree, which tip is the most advanced — the most evolved?",
      "trees": ["birds"],
      "style": { "shape": "rectangular", "tips": "up" },
      "question": {
        "type": "concept",
        "options": [
          "No tip — every living lineage descends from the same root",
          "The tip whose branch left the rest of the tree first",
          "The tip at the end of the longest chain of splits"
        ],
        "correct": [0]
      }
    },
    {
      "id": "q-rot",
      "text": "One of these trees shows different relationships from the other two. Rotate nodes freely — which tree is it?",
      "trees": ["birds", "birds-rot", "birds-diff"],
      "style": {
        "shape": "rectangular",
        "tips": "right",
        "per_tree": [
          { "shape": "rectangular", "tips": "right" },
          { "shape": "rectangular", "tips": "up" },
          { "shape": "diagonal", "tips": "right" }
        ]
      },
      "rotate_tool": true,
      "question": { "type": "which_differs" }
    },
    {
      "id": "q-select",
      "text": "Select every true statement. The node letters are on the first tree.",
      "trees": ["birds-lettered", "birds-rot", "birds-diff"],
      "question": {
        "type": "select_true",
        "statements": [
          {
            "kind": "same_relationships",
            "tree_i": 0,
            "tree_j": 1,
            "text": "The first and second trees show the same relationships."
          },
          {
            "kind": "older_than",
            "p": "N",
            "q": "G",
            "text": "Node N is older than node G."
          },
          {
            "kind": "older_than",
            "p": "G",
            "q": "A",
            "text": "Node G is older than node A."
          },
          {
            "kind": "same_relationships",
            "tree_i": 0,
            "tree_j": 2,
            "text": "The first and third trees show the same relationships."
          }
        ]
      }
    },
    {
      "id": "q-closest",
      "text": "Tap {a}'s closest relative.",
      "trees": ["birds"],
      "a": "ostrich",
      "question": { "type": "closest_relative", "form": "closest" }
    },
    {
      "id": "q-pair",
      "text": "Is {a} more closely related to {b} or to {c}?",
      "trees": ["birds"],
      "a": "penguin",
      "b": "albatross",
      "c": "chicken",
      "question": { "type": "closest_relative", "form": "pairwise" }
    },
    {
      "id": "q-equal",
      "text": "Is {a} more closely related to {b} or to {c}?",
      "trees": ["grasses"],
      "style": { "shape": "diagonal", "tips": "up" },
      "a": "wheat",
      "b": "rice",
      "c": "corn",
      "question": { "type": "closest_relative", "form": "pairwise" }
    },
    {
      "id": "q-clade",
      "text": "Do {set} form a clade — a node plus every tip that descends from it?",
      "trees": ["marsupials"],
      "tips": ["kangaroo", "koala"],
      "question": { "type": "is_clade" }
    },
    {
      "id": "q-smallest",
      "text": "Tap the smallest clade that contains {set}.",
      "trees": ["marsupials"],
      "tips": ["kangaroo", "koala"],
      "question": { "type": "smallest_clade" }
    },
    {
      "id": "q-fly",
      "text": "Are the taxa that can fly monophyletic, paraphyletic or polyphyletic?",
      "trees": ["birds"],
      "question": { "type": "is_clade", "by_trait": "flight" }
    },
    {
      "id": "q-feathered",
      "text": "Tap every tip that has feathers but cannot fly.",
      "trees": ["birds"],
      "question": {
        "type": "trait",
        "ask": {
          "kind": "has_not",
          "has": "feathers",
          "lacks": "flight"
        }
      }
    },
    {
      "id": "q-count",
      "text": "How many clades does this tree show? Count every internal node, including the root; single tips are not clades.",
      "trees": ["marsupials"],
      "question": { "type": "count_clades" }
    },
    {
      "id": "q-order",
      "text": "Order the lettered nodes from oldest to youngest.",
      "trees": ["birds-lettered"],
      "note_after": "A node is older than every node below it. Nodes on separate lineages — like G and A — cannot be ordered: every order consistent with ancestry is accepted.",
      "question": { "type": "order_nodes", "nodes": ["A", "B", "G", "N", "R"] }
    }
  ]
}
