{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NeoPhylo exercise file",
  "description": "Lesson/exercise file format, schema v2 (v1.1 design spec section 3.6). This schema mirrors the validation in crates/neophylo-core/src/exercise.rs: unknown properties are ignored, `locked` and `prompts` are optional, and sim.kappa is required only when sim.model is \"K80\". Both schema_version 1 (the flat v1 layout, still accepted for old links) and 2 are valid; the version-specific shape is enforced by the if/then blocks below. Numeric fields follow the engine's effective ranges (sim.length 10..=10000, sim.seed 0..=2^53-1, at_step 0..). Model/alphabet compatibility, embedded-FASTA alphabet matching and reference label matching are semantic checks the engine performs; this schema only covers structure.",
  "type": "object",
  "required": ["schema_version", "id", "title", "analysis"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1, 2] },
    "id": { "type": "string" },
    "title": { "type": "string" },
    "locked": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Dotted control paths fixed for the lesson, e.g. \"sim.model\"."
    },
    "prompts": { "$ref": "#/$defs/prompts" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schema_version": { "const": 1 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["true_tree", "sim"],
        "properties": {
          "true_tree": {
            "type": "string",
            "description": "Newick string; every non-root node must carry a branch length. Syntax is checked by the engine, not by this schema."
          },
          "sim": { "$ref": "#/$defs/simV1" },
          "analysis": { "$ref": "#/$defs/analysisV1" }
        }
      }
    },
    {
      "if": {
        "properties": { "schema_version": { "const": 2 } },
        "required": ["schema_version"]
      },
      "then": {
        "required": ["alphabet", "data"],
        "properties": {
          "alphabet": { "enum": ["dna", "protein"] },
          "data": { "$ref": "#/$defs/data" },
          "reference": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "required": ["newick", "kind"],
                "properties": {
                  "newick": {
                    "type": "string",
                    "description": "Newick string for the reference tree; its leaf labels must equal the alignment's labels (checked by the engine)."
                  },
                  "kind": { "enum": ["true", "classification"] }
                }
              }
            ]
          },
          "analysis": { "$ref": "#/$defs/analysisV2" }
        }
      }
    }
  ],
  "$defs": {
    "simV1": {
      "type": "object",
      "required": ["model", "length", "seed"],
      "properties": {
        "model": { "enum": ["JC69", "K80"] },
        "kappa": { "type": "number" },
        "length": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "allOf": [{ "$ref": "#/$defs/kappaForK80" }]
    },
    "simV2": {
      "type": "object",
      "required": ["model", "length", "seed"],
      "properties": {
        "model": { "enum": ["JC69", "K80", "JTT"] },
        "kappa": { "type": "number" },
        "length": { "type": "integer", "minimum": 10, "maximum": 10000 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "allOf": [{ "$ref": "#/$defs/kappaForK80" }]
    },
    "kappaForK80": {
      "if": {
        "properties": { "model": { "const": "K80" } },
        "required": ["model"]
      },
      "then": {
        "required": ["kappa"],
        "properties": {
          "kappa": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "analysisV1": {
      "type": "object",
      "required": ["correction", "method"],
      "properties": {
        "correction": { "enum": ["p", "JC69", "K80"] },
        "method": { "enum": ["NJ", "UPGMA"] }
      }
    },
    "analysisV2": {
      "type": "object",
      "required": ["correction", "method"],
      "properties": {
        "correction": { "enum": ["p", "JC69", "K80", "Kimura", "JTT"] },
        "method": { "enum": ["NJ", "UPGMA"] }
      }
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "true_tree", "sim"],
          "properties": {
            "kind": { "const": "simulated" },
            "true_tree": {
              "type": "string",
              "description": "Newick string; every non-root node must carry a branch length. Syntax is checked by the engine, not by this schema."
            },
            "sim": { "$ref": "#/$defs/simV2" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "fasta", "source"],
          "properties": {
            "kind": { "const": "embedded" },
            "fasta": {
              "type": "string",
              "description": "Aligned FASTA text embedded in the lesson; it must parse and match the declared alphabet (checked by the engine)."
            },
            "source": {
              "type": "object",
              "required": ["citation", "license", "accessions"],
              "properties": {
                "citation": { "type": "string" },
                "license": { "type": "string" },
                "accessions": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at_step", "type", "concept"],
        "properties": {
          "at_step": {
            "type": "integer",
            "minimum": 0,
            "description": "1-based number of the join being discussed. The prompt appears at stepper position at_step-1, where that join is still the pending join; one past the last join (at_step = steps+2 for NJ, steps+1 for UPGMA) shows on the completed tree. A predict_pair must never target NJ's final three-way join — there is no pair to predict."
          },
          "type": { "enum": ["predict_pair", "note"] },
          "concept": { "type": "string" },
          "math": { "type": ["string", "null"] },
          "reveal": {
            "type": ["string", "null"],
            "description": "Optional explanation a predict_pair card shows only after the student picks (e.g. why the closest pair is not the answer); must not spoil the question."
          }
        }
      }
    }
  }
}
