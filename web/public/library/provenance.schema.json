{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neophylo.dev/library/provenance.schema.json",
  "title": "NeoPhylo library dataset provenance",
  "type": "object",
  "required": [
    "id",
    "title",
    "accessions",
    "source",
    "retrieved",
    "license",
    "citation",
    "sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "accessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["accession", "label"],
        "additionalProperties": false,
        "properties": {
          "accession": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "pattern": "^[^\\s\"]+$" }
        }
      }
    },
    "source": {
      "type": "string",
      "enum": ["NCBI Nucleotide", "NCBI Protein", "UniProtKB"]
    },
    "retrieved": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "license": { "type": "string", "minLength": 1 },
    "citation": { "type": "string", "minLength": 1 },
    "aligner": {
      "type": "object",
      "required": ["name", "version", "args"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "enum": ["MAFFT"] },
        "version": { "type": "string", "minLength": 1 },
        "args": { "type": "string" }
      }
    },
    "published_alignment": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "oneOf": [
    { "required": ["aligner"] },
    { "required": ["published_alignment"] }
  ]
}
